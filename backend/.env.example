# Local-first settings — copy to .env and adjust. Never commit .env.

APP_NAME=context-aware-dev-assistant
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# SQLite (local file; no remote DB)
DATABASE_PATH=./data/events.db

# Privacy defaults — must remain false to accept events
STORE_RAW_SOURCE_CODE=false
STORE_PASSWORDS_OR_TOKENS=false
STORE_SENSITIVE_BROWSER_DATA=false

# Local-development consent/session bootstrap shortcut.
# Creates consent + session in one POST /sessions when bootstrap_consent=true.
# Ignored unless APP_ENV=development. Disable for production.
ALLOW_DEV_CONSENT_BOOTSTRAP=true

# Feature flags (later phases)
ENABLE_RAG=false
ENABLE_OLLAMA=false
ENABLE_LEARNED_TIMING=false

# Ollama (later)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3

# ChromaDB (later)
# CHROMA_PATH=./data/chroma
